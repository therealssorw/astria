[Unit]
Description=Astria Discord scorekeeper bot
Documentation=https://github.com/sssorw/astria/blob/master/tools/discord_bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/astria-bot
# The token lives outside the deploy directory so a redeploy cannot clobber it
# and a stray `ls /opt` cannot leak it.
EnvironmentFile=/etc/astria-discord-bot.env
# So do the tallies: /opt/astria-bot is replaced wholesale on every deploy.
Environment=ASTRIA_BOT_DATA=/var/lib/astria-bot/counts.json
ExecStart=/usr/bin/node /opt/astria-bot/bot.js
Restart=always
RestartSec=10s
# Discord's gateway drops connections; a bot that gives up after five restarts
# in ten seconds would be down for good after one bad afternoon.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
